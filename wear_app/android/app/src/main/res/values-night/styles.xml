<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Wear OS Splash Screen Theme (Dark/Night Mode) -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen (pure black for OLED) -->
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <!-- Exactly 48x48dp app icon per Wear OS guidelines (WO-V15) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_icon</item>
        <!-- Theme to switch to after the splash screen is done -->
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
